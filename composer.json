{
    "name": "stougeiro/cache",
    "description": "Performant cache implementation package providing file-based and SQLite-backed handlers. Features optimized I/O with line-based serialization, WAL-mode SQLite, and modular design for PHP applications.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "cache",
        "file-cache",
        "sqlite-cache",
        "cache-handler",
        "cache-storage",
        "cache-contract",
        "php-cache",
        "caching",
        "performance",
        "lightweight",
        "modular"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/cache/issues",
        "source": "https://github.com/stougeiro/cache"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Cache\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/cache-contract": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "carthage-software/mago": "^1.48",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
